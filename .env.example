# Serbia Facade Lead Engine — environment template.
# Copy to `.env.local` and fill in. Never commit a filled-in file.

# ---------------------------------------------------------------------------
# Database — SQLite is the system of record.
# ---------------------------------------------------------------------------

# Path to the SQLite database file, relative to the repository root.
DATABASE_PATH=./data/leads.sqlite

# ---------------------------------------------------------------------------
# Scraper politeness — required. We identify the crawler honestly.
# ---------------------------------------------------------------------------

# Sent as the User-Agent on every request. Must name the project and a contact.
SCRAPER_USER_AGENT=serbia-facade-lead-engine/0.1 (+mailto:you@example.com)

# Contact address a site owner can reach us at. Also used in the User-Agent.
SCRAPER_CONTACT_EMAIL=you@example.com

# Honour robots.txt. Leave as true — set false only for a host that has given
# written permission, and record that permission in the source's README.
SCRAPER_RESPECT_ROBOTS=true

# Minimum delay between two requests to the same host, in milliseconds.
SCRAPER_REQUEST_DELAY_MS=1500

# Parallel in-flight requests across all hosts.
SCRAPER_CONCURRENCY=2

# Per-request timeout, in milliseconds.
SCRAPER_TIMEOUT_MS=20000

# Retries for a transient failure (timeout, 5xx). 429 always backs off instead.
SCRAPER_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Playwright — used only where JS rendering is genuinely required.
# ---------------------------------------------------------------------------

PLAYWRIGHT_HEADLESS=true

# ---------------------------------------------------------------------------
# Export
# ---------------------------------------------------------------------------

# Directory the XLSX export is written to.
EXPORT_DIR=./exports

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Paid sources — DEFERRED. Do not set without an explicit go-ahead in the issue.
# ---------------------------------------------------------------------------

# Google Places API. Deferred to a later phase and decided with measured yield
# numbers. Leaving this unset is the expected state.
GOOGLE_PLACES_API_KEY=
