{
  "_meta": {
    "description": "Settlement, suburb and city-district aliases that resolve to a municipality id in data/serbia-geo.json. Used by resolveCity() in src/lib/normalize/city.ts when a source publishes a village or a neighbourhood instead of the municipality.",
    "settlement_count": 300,
    "municipalities_covered": 94,
    "kinds": {
      "settlement": "A naselje in its own right — the source may legitimately print it as the town.",
      "neighbourhood": "A part of a town, not a separate naselje. Present because directories print it as if it were one.",
      "city_district": "A gradska opština of a city other than Belgrade (Niš, Požarevac). Those are not local self-government units, so they are not in serbia-geo.json."
    },
    "rules": [
      "municipality_id must exist in data/serbia-geo.json; the test suite fails the build if it does not.",
      "A name that is already a municipality or city-municipality name in serbia-geo.json is never listed here — the geo dataset wins.",
      "Names ambiguous across municipalities (Prnjavor, Popovac, Markovac, Crna Bara, Medveđa as a village) are deliberately omitted: resolveCity returns null with a reason rather than guessing, because a wrong city is worse than an empty one.",
      "This is a curated seed list of the settlements Serbian business directories actually print, not the full ~4,700-settlement register. Adding an entry is a data change, reviewed like code."
    ],
    "sources": [
      {
        "name": "Statistical Office of the Republic of Serbia — settlement register (naselja) by municipality",
        "url": "https://www.stat.gov.rs/",
        "used_for": "settlement-to-municipality assignment"
      },
      {
        "name": "Wikipedia (sr) — municipality articles, section Насеља",
        "url": "https://sr.wikipedia.org/wiki/Градови_и_општине_Србије",
        "used_for": "cross-check of the settlement lists per municipality"
      }
    ]
  },
